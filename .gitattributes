# Git LFS — anything binary and heavy lives outside regular git history.
# The dashboard's index.html stays in git (small, we want to diff it).
masks/*.mat       filter=lfs diff=lfs merge=lfs -text
masks/*.tif       filter=lfs diff=lfs merge=lfs -text
masks/*.tiff      filter=lfs diff=lfs merge=lfs -text
masks/*.png       filter=lfs diff=lfs merge=lfs -text
masks/*.npy       filter=lfs diff=lfs merge=lfs -text
previews/*.jpg    filter=lfs diff=lfs merge=lfs -text
previews/*.jpeg   filter=lfs diff=lfs merge=lfs -text
previews/*.png    filter=lfs diff=lfs merge=lfs -text
